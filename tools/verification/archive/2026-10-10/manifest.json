        "crates/fsr-sdk/tests/native/sharpening.rs"
      ]
    },
    "dated-audits": {
      "purpose": "Original independent sharpening decoder and D013 cleanup matrix collector/ordinary checks.",
      "requirements": [
        "PowerShell 7/.NET for the half decoder; Cargo/stable/MSRV tools for ordinary checks.",
        "Recorded target-stage logs, source identities and raw readbacks; D013 collector uses the repository as its working directory and writes beside its original script."
      ],
      "repository_inputs": [
        "docs/research/records/2026-10-08-exp-d013-native-transfer-cleanup.md",
        "docs/research/records/2026-09-30-exp-d014-native-sharpening.md",
        "crates/fsr-sdk/tests/native/thread_transfers.rs",
        "crates/fsr-sdk/tests/native/sharpening.rs",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "outcomes": "Preserve failed sharpening criteria and the D013 collector's bounded cleanup/payload comparisons. These are not general native safety or image-quality gates."
    },
    "native-regressions": {
      "purpose": "Archive-time context snapshots; original files remain active and are not retired by this change.",
      "requirements": [
        "PowerShell 7; Cargo; Windows x64/MSVC/local SDK and recorded hardware for native execution. CI ABI mode may fetch hash-pinned headers."
      ],
      "repository_inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates",
        ".github/workflows/ci.yml",
        "docs/DEVELOPMENT.md"
      ],
      "outcomes": "Active shared runner/ABI/API checks retain their behavior. Frozen copies explain dependencies of retired scripts, not the exact equipment used by every earlier run."
    }
