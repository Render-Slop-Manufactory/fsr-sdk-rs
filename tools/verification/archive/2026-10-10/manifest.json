  "groups": {
    "milestone-wrappers": {
      "purpose": "Retired M4/M5/M6 aliases; lifecycle/dispatch remain available through the active shared native runner.",
      "requirements": [
        "Original crate-relative layout; PowerShell; Cargo and cached declared dependencies. Native mode additionally needs the native-regressions requirements."
      ],
      "repository_inputs": [
        "crates/fsr-sdk/tests/native/run.ps1"
      ],
      "outcomes": "Wrappers delegate to lifecycle or dispatch; they are not independent verification cases."
    },
    "native-diagnostics": {
      "purpose": "Frozen recording-ahead, GBV, dimension, allocation/input-lifetime, provider-deployment and shared-runtime experiments. Their Rust/C++ equipment remains in the repository for future migration.",
      "requirements": [
        "Windows x64/MSVC developer shell; trusted local SDK v2.3.0 headers and signed loader/provider deployment; applicable hardware/debug-layer requirements.",
        "Original script paths and a compatible source state. Each script owns its staging, watchdog and environment rules; fixed stages can overwrite earlier attempts."
      ],
      "repository_inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/fsr-sdk/Cargo.toml",
        "crates/fsr-sdk-sys/Cargo.toml",
        "crates/fsr-sdk/tests/native",
        "crates/fsr-sdk/src",
        "crates/fsr-sdk-sys/src",
        "crates/fsr-sdk-sys/tests/context_lifecycle",
        "crates/fsr-sdk-sys/tests/context_dimensions.rs",
        "crates/fsr-sdk-sys/tests/context_lifecycle.rs",
        "crates/fsr-sdk-sys/tests/query.rs",
        "crates/fsr-sdk-sys/tests/provider_resolution/modules.rs",
        "crates/fsr-sdk-sys/tests/shared_runtime.rs"
      ],
      "outcomes": "Recording-ahead aggregates selected failures; GBV gates its control but records dispatch timeout; dimensions/shared-runtime record child statuses; provider deployment includes expected negative layouts; allocation/input-lifetime controls and raw aborts retain their original meanings. Parent exit 0 is not a universal child-pass claim."
    },
    "m9-release": {
      "purpose": "Historical projected candidate that excluded the public movable family; superseded for publication by the complete 0.2.0 record, not rewritten to match it.",
      "requirements": [
        "Python standard library; recorded Cargo/stable/MSRV tools and cached registry archives; the pre-projection source expected by prepare-candidate.py.",
        "Generated target/m9-release-20261010-final source, archives, isolated registry, check logs and native stage/readback inputs. Collectors write beside their original scripts."
      ],
      "repository_inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "LICENSE",
        "crates",
        "docs/release/2026-10-10-m9-verification.md"
      ],
      "outcomes": "Projected candidate/archive/consumer acceptance is separate from image diagnostics and publication. The preparation script expects pre-0.2.0 source and is not a current release recipe.",
      "intake_repository_inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "LICENSE",
        "crates",
        "docs/release/2026-10-10-m9-verification.md",
        "docs/release/2026-10-09-m9-native-sharpening-protocol.md"
      ]
    },
    "complete-release": {
      "purpose": "Historical complete 0.2.0/0.1.1 verification, including movable, archive/registry isolation, content audit and evidence collection.",
      "requirements": [
        "Python standard library; recorded Cargo/stable/MSRV tools and cached registry archives; exact candidate/package inputs.",
        "Generated target/release-020-20261010 archives, registry, check/dry-run logs, API controls, source/artifact movable stages and M9 artifact readbacks.",
        "collect-release.py imports the frozen M9 collector at its original path. Collectors/audits write into their original historical evidence directories; use a disposable reconstruction only."
      ],
      "repository_inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "LICENSE",
        "README.md",
        "crates",
        "docs/ROADMAP_HISTORY.md",
        "docs/release/2026-10-10-m9-verification.md",
        "docs/research/records/2026-09-30-exp-d014-native-sharpening.md",
        "crates/fsr-sdk/tests/native/sharpening.rs"
      ],
      "outcomes": "Expected compiler errors are passing negative controls. Resume reuse is label/exit based, not input-checked. Package verification, native integration, content audit and publication observation remain distinct.",
      "intake_repository_inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "LICENSE",
        "README.md",
        "crates",
        "docs/release/2026-10-10-0.2.0-release-verification.md",
