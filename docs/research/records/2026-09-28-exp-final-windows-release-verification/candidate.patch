+            *helper.get::<CreateHarness>(b"m6_create\0").unwrap(),
+            *helper
+                .get::<SetTemporalFrame>(b"m6_set_temporal_frame\0")
+                .unwrap(),
+            *helper.get::<Finish>(b"m6_finish\0").unwrap(),
+            *helper.get::<Destroy>(b"m6_destroy\0").unwrap(),
+        )
